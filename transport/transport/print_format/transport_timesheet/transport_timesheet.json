 "doctype": "Print Format",
 "font_size": 12,
 "html": "<style>\n  .tsheet { width: 100%; border-collapse: collapse; font-size: 12px; }\n  .tsheet td, .tsheet th { border: 1.5px solid #000; padding: 3px 6px; vertical-align: middle; }\n  .tsheet .title { font-weight: 700; font-size: 14px; }\n  .tsheet .month { text-align: center; font-weight: 700; }\n  .tsheet .label { font-weight: 700; font-size: 11px; width: 16%; }\n  .tsheet .head th { text-align: center; font-weight: 700; background: #f3f3f3; }\n  .tsheet .pickup-head { background: #fff200; }\n  .tsheet td.c { text-align: center; }\n  .tsheet tr.off td { font-weight: 700; }\n  .tsheet tr.off td.remark { color: #b00020; }\n  .totals { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }\n  .totals td { border: 1.5px solid #000; padding: 4px 8px; }\n  .totals td.k { font-weight: 700; width: 24%; background: #f3f3f3; }\n  .sign { width: 100%; margin-top: 28px; font-size: 12px; }\n  .sign td { width: 50%; padding-top: 30px; border-top: 0; }\n</style>\n{% set m = get_timesheet_matrix(doc) %}\n<table class=\"tsheet\">\n  <tr>\n    <td class=\"title\" colspan=\"4\">TIMESHEET</td>\n    <td class=\"month\" colspan=\"2\">{{ m.month_label }}</td>\n  </tr>\n  <tr>\n    <td class=\"label\">CLIENT NAME:</td>\n    <td colspan=\"3\">{{ m.client }}</td>\n    <td class=\"label\">VEHICLE TYPE</td>\n    <td class=\"c\">{{ m.vehicle_types }}</td>\n  </tr>\n  <tr>\n    <td class=\"label\">TRIPS:</td>\n    <td colspan=\"3\" class=\"c\"><b>{{ m.trips_description or m.project_name }}</b><br>{{ m.project_name }}</td>\n    <td class=\"label\">DRIVERS NAME:</td>\n    <td>{{ m.drivers }}</td>\n  </tr>\n  <tr class=\"head\">\n    <th>SL #</th>\n    <th>DATE</th>\n    <th class=\"pickup-head\">MORNING PICKUP</th>\n    <th class=\"pickup-head\">EVENING DROP OFF</th>\n    <th>ADDITIONAL</th>\n    <th>REMARKS</th>\n  </tr>\n  {% for d in m.days %}\n  <tr class=\"{{ 'off' if d.is_off else '' }}\">\n    <td class=\"c\">{{ d.sl }}</td>\n    <td class=\"c\">{{ d.date }}</td>\n    <td class=\"c\">{{ d.pickup | safe }}</td>\n    <td class=\"c\">{{ d.drop | safe }}</td>\n    <td class=\"c\">{{ d.additional | safe }}</td>\n    <td class=\"c remark\">{{ d.remarks }}</td>\n  </tr>\n  {% endfor %}\n</table>\n\n<table class=\"totals\">\n  <tr>\n    <td class=\"k\">Total Trips</td><td>{{ doc.total_trips or 0 }}</td>\n    <td class=\"k\">Additional Trips</td><td>{{ doc.total_additional_trips or 0 }}</td>\n  </tr>\n  <tr>\n    <td class=\"k\">Saturday Trips</td><td>{{ doc.total_saturday_trips or 0 }}</td>\n    <td class=\"k\">Sunday Trips</td><td>{{ doc.total_sunday_trips or 0 }}</td>\n  </tr>\n  <tr>\n    <td class=\"k\">Public Holiday Trips</td><td>{{ doc.total_public_holiday_trips or 0 }}</td>\n    <td class=\"k\">Overtime Hours</td><td>{{ \"%.1f\"|format(doc.total_ot_hours or 0) }}</td>\n  </tr>\n</table>\n\n<table class=\"sign\">\n  <tr>\n    <td>Operations In-charge: {{ doc.operations_approved_by or \"\" }}<br>Signature: ____________________</td>\n    <td>Customer: {{ doc.customer_approved_by or \"\" }}<br>Signature &amp; Stamp: ____________________</td>\n  </tr>\n</table>\n",
